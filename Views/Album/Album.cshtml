@for(int i = 0; i < ViewBag.NombreSelecciones.Count; i++)
{
    <section>
        <h1>@ViewBag.NombreSelecciones[i]</h1>
        @for(int x = i * 5 + 1; x < i * 5 + 6; x++)
        {
            <div>
            @{
                bool encontrado = false;
            }
               @for( int y = 0; y < ViewBag.figusUsuario.Count; y++)
               {
                   if(ViewBag.figusUsuario[y].Id == ViewBag.TodasLasFigus[x].Id && ViewBag.figusUsuario[y].IdSeleccion == x)
                   {
                       <img src="~/images/jugadores/@ViewBag.figusUsuario[y].Imagen" alt="@ViewBag.figusUsuario[y].Nombre" />
                       encontrado = true;
                   }
               }
               @if(!encontrado)
               {
                   <img src="~/images/fondo.png" alt="Figurita no encontrada" />
               }
            </div>
        }
        
    </section>
}

