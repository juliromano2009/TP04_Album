@for(int i = 0; i < ViewBag.NombreSelecciones.Count; i++)
{
    <section>
        <h1>@ViewBag.NombreSelecciones[i]</h1>
        @for(int x = i * 5 + 1; x <= ViewBag.TodasLasFigus.Count; x++)
        {
            <div>
                if(@ViewBag.FigusUsuario[i] == null)
                {
                    <img src="fondo.png" alt="">
                }
                else{
                    <img src="@ViewBag.FigusUsuario[i].Imagen" alt="">
                }
            </div>
        }
        
    </section>
}

