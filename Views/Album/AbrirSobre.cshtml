<head>
    <title>Abrir Sobre</title>
</head>
<body>
    <h1>Abrir Sobre</h1>
    <ul>
        @foreach (var figurita in ViewBag.Sobre)
        {
            <li>
                <img src="~/images/jugadores/@figurita.Imagen" alt="" />
            </li>
        }
    </ul>
<button type="button" onclick='location.href="@Url.Action("ConfirmarSobre", "Album", new {f1 = @ViewBag.Sobre[0].Numero , f2 =  @ViewBag.Sobre[1].Numero , f3  = @ViewBag.Sobre[2].Numero, f4 = @ViewBag.Sobre[3].Numero, f5 = @ViewBag.Sobre[4].Numero })"'>Confirmar Sobre</button>
</body>