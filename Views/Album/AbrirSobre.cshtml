<<!DOCTYPE html>
<html>
<head>
    <title>Abrir Sobre</title>
</head>
<body>
    <h1>Abrir Sobre</h1>
    <ul>
        @foreach (var figurita in ViewBag.Sobre)
        {
            <li>
                <img src="@figurita.Imagen" alt="@figurita.Nombre" />
            </li>
        }
    </ul>
    
<button type="button" onclick='location.href="@Url.Action("ConfirmarSobre", "Album")"'>Confirmar Sobre</button>

</body>
</html>